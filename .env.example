# Copy to .env and fill in. Never commit .env.

# --- Twilio WhatsApp ---
# Get these from https://console.twilio.com/
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Sandbox number while testing: whatsapp:+14155238886
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# The group JID or broadcast list the bot should post daily/weekly recaps to.
# For Twilio sandbox development this can be a single whatsapp:+<number>.
TWILIO_RECAP_TO=

# --- Supabase ---
# Get these from https://app.supabase.com/project/_/settings/api
SUPABASE_URL=
# Use the service_role key for server-side inserts (NEVER expose this client-side).
SUPABASE_KEY=

# --- App ---
APP_TIMEZONE=Australia/Sydney
# Set to "true" to enable verbose parser debug logging.
DEBUG_PARSERS=false
