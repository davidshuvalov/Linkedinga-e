# Copy to .env and fill in. Never commit .env.

# --- Twilio WhatsApp ---
# Get these from https://console.twilio.com/
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Sandbox number while testing: whatsapp:+14155238886
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# The group JID or broadcast list the bot should post daily/weekly recaps to.
# For Twilio sandbox development this can be a single whatsapp:+<number>.
TWILIO_RECAP_TO=
# Optional: public URL of this app's /twilio-status endpoint, e.g.
# https://your-app.up.railway.app/twilio-status. When set, every TwiML
# reply gets a statusCallback attribute pointing at it, and Twilio will
# POST outbound delivery status (delivered / failed / undelivered with
# error code) back so carrier rejections like WhatsApp 63012 land in
# your app logs instead of being silent. Leave blank to disable.
TWILIO_STATUS_CALLBACK_URL=

# --- Supabase ---
# Get these from https://app.supabase.com/project/_/settings/api
SUPABASE_URL=
# Use the service_role key for server-side inserts (NEVER expose this client-side).
SUPABASE_KEY=

# --- App ---
APP_TIMEZONE=Australia/Sydney
# Comma-separated list of games that count toward the leaderboard.
# Scores for disabled games are still recorded but not scored.
# Default: queens,tango,zip,patches,mini_sudoku (pinpoint and crossclimb OFF)
ENABLED_GAMES=queens,tango,zip,patches,mini_sudoku
